# x86 host: ROS2 Humble + robosuite/MuJoCo + PyTorch (CPU/GPU) for the plant and the
# PyTorch-fallback controller. Used during development and for the no-network baseline.
FROM osrf/ros:humble-desktop

ENV DEBIAN_FRONTEND=noninteractive
# CycloneDDS, not the osrf/ros default rmw_fastrtps_cpp: the Jetson controller image
# (dustynv/ros base) ships rmw_cyclonedds_cpp, and the true cross-machine HiL run (controller on
# Jetson, this image on the desktop, see controller.launch.py) needs both ends on the same RMW to
# use the pinned-interface/unicast-peers discovery config (docker/cyclonedds-*.xml), without which
# discovery over the direct link silently never completes (see those files' comments for why).
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip libgl1 libosmesa6-dev libglfw3 ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws
COPY requirements-host.txt /ws/
RUN pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128 \
    && pip install --no-cache-dir -r requirements-host.txt

# diffusion_policy-repo checkpoint support (see evh_controller/dp_repo_policy.py):
# deps + a baked clone of the repo; a mounted /ws/external copy is used if EVH_DP_REPO unset.
COPY scripts/setup_dp_deps.sh /tmp/setup_dp_deps.sh
RUN bash /tmp/setup_dp_deps.sh \
    && git clone --depth 1 https://github.com/real-stanford/diffusion_policy /opt/diffusion_policy
ENV EVH_DP_REPO=/opt/diffusion_policy

COPY ros2_ws /ws/ros2_ws
RUN . /opt/ros/humble/setup.sh && cd /ws/ros2_ws && colcon build --symlink-install

COPY docker/entrypoint-host.sh /entrypoint-host.sh
RUN chmod +x /entrypoint-host.sh
ENTRYPOINT ["/entrypoint-host.sh"]
CMD ["bash"]
